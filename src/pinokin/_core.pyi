from __future__ import annotations

import enum

import numpy as np
from numpy.typing import NDArray

class Robot:
    def __init__(self, urdf_path: str, ee_frame: str = "") -> None: ...
    @staticmethod
    def from_urdf_string(urdf_string: str, ee_frame: str = "") -> Robot: ...
    def fkine(self, q: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def fkine_into(self, q: NDArray[np.float64], out: NDArray[np.float64]) -> None: ...
    def jacob0(self, q: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def jacob0_into(self, q: NDArray[np.float64], out: NDArray[np.float64]) -> None: ...
    def jacobe(self, q: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def batch_fk(self, joint_positions: NDArray[np.float64]) -> list[NDArray[np.float64]]: ...
    @property
    def name(self) -> str: ...
    @property
    def nq(self) -> int: ...
    @property
    def lower_limits(self) -> NDArray[np.float64]: ...
    @property
    def upper_limits(self) -> NDArray[np.float64]: ...
    @property
    def velocity_limits(self) -> NDArray[np.float64]: ...
    @property
    def qlim(self) -> NDArray[np.float64]: ...
    def set_ee_frame(self, name: str) -> None: ...
    def set_tool_transform(self, T_tool: NDArray[np.float64]) -> None: ...
    def clear_tool_transform(self) -> None: ...
    @property
    def has_tool_transform(self) -> bool: ...

class Method(enum.Enum):
    GN = ...
    NR = ...
    LM = ...

class Damping(enum.Enum):
    Chan = ...
    Wampler = ...
    Sugihara = ...

class BatchResult:
    joint_positions: NDArray[np.float64]
    valid: list[bool]
    all_valid: bool

class IKSolver:
    def __init__(
        self,
        robot: Robot,
        method: Method = Method.LM,
        damping: Damping = Damping.Sugihara,
        tol: float = 1e-6,
        lm_lambda: float = 1.0,
        max_iter: int = 30,
        max_restarts: int = 100,
        enforce_limits: bool = True,
    ) -> None: ...
    def solve(
        self,
        Tep: NDArray[np.float64],
        q0: NDArray[np.float64] | None = None,
    ) -> bool: ...
    def batch_ik(
        self,
        poses: list[NDArray[np.float64]],
        q_start: NDArray[np.float64],
        stop_on_failure: bool = False,
    ) -> BatchResult: ...
    def set_we(self, we: NDArray[np.float64]) -> None: ...
    @property
    def q(self) -> NDArray[np.float64]: ...
    @property
    def success(self) -> bool: ...
    @property
    def residual(self) -> float: ...
    @property
    def iterations(self) -> int: ...
    @property
    def restarts(self) -> int: ...

class CollisionChecker:
    def __init__(
        self,
        robot: Robot,
        urdf_path: str,
        package_dirs: list[str] = ...,
        add_all_pairs: bool = True,
        remove_adjacent_pairs: bool = True,
        clearance_margin: float = 0.0,
    ) -> None: ...
    def load_srdf(self, srdf_path: str) -> None: ...
    def add_collision_pair(self, first: int, second: int) -> None: ...
    def remove_collision_pair(self, first: int, second: int) -> None: ...
    def in_collision(self, q: NDArray[np.float64]) -> bool: ...
    def colliding_pairs(self, q: NDArray[np.float64]) -> list[tuple[str, str]]: ...
    def min_distance(self, q: NDArray[np.float64]) -> float: ...
    def check_segment(
        self,
        q0: NDArray[np.float64],
        q1: NDArray[np.float64],
        n_steps: int,
        include_endpoints: bool = True,
    ) -> bool: ...
    def check_path(self, q_path: NDArray[np.float64]) -> int: ...
    def set_clearance_margin(self, margin: float) -> None: ...
    @property
    def clearance_margin(self) -> float: ...
    def add_obstacle(
        self,
        name: str,
        kind: str,
        params: list[float],
        world_pose: NDArray[np.float64],
        margin: float | None = None,
    ) -> int: ...
    def add_obstacle_box(
        self, name: str, half_extents: NDArray[np.float64], world_pose: NDArray[np.float64]
    ) -> int: ...
    def add_obstacle_sphere(
        self, name: str, radius: float, world_pose: NDArray[np.float64]
    ) -> int: ...
    def add_obstacle_cylinder(
        self, name: str, radius: float, length: float, world_pose: NDArray[np.float64]
    ) -> int: ...
    def add_obstacle_mesh(
        self,
        name: str,
        mesh_path: str,
        world_pose: NDArray[np.float64],
        mesh_scale: NDArray[np.float64] = ...,
    ) -> int: ...
    def attach_box_to_frame(
        self,
        name: str,
        half_extents: NDArray[np.float64],
        parent_frame: str,
        placement: NDArray[np.float64],
    ) -> int: ...
    def attach_sphere_to_frame(
        self, name: str, radius: float, parent_frame: str, placement: NDArray[np.float64]
    ) -> int: ...
    def attach_cylinder_to_frame(
        self,
        name: str,
        radius: float,
        length: float,
        parent_frame: str,
        placement: NDArray[np.float64],
    ) -> int: ...
    def attach_mesh_to_frame(
        self,
        name: str,
        mesh_path: str,
        parent_frame: str,
        placement: NDArray[np.float64],
        mesh_scale: NDArray[np.float64] = ...,
    ) -> int: ...
    def set_geometry_pose_by_name(self, name: str, pose: NDArray[np.float64]) -> None: ...
    def geometry_world_pose(self, name: str) -> NDArray[np.float64]: ...
    def remove_geometry_by_name(self, name: str) -> None: ...
    def reparent_geometry_by_name(
        self, name: str, new_parent_frame: str, new_placement: NDArray[np.float64]
    ) -> None: ...
    def update_placements(self, q: NDArray[np.float64]) -> None: ...
    @property
    def num_collision_pairs(self) -> int: ...
    @property
    def num_geometry_objects(self) -> int: ...
    @property
    def geometry_names(self) -> list[str]: ...
    @property
    def geometry_link_names(self) -> list[tuple[str, str]]: ...
    def has_geometry(self, name: str) -> bool: ...
